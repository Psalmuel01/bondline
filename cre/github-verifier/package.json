{
  "name": "bondline-cre-github-verifier",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare:receiver": "node ./prepare-receiver.mjs",
    "simulate:local": "node ./local-simulation.mjs",
    "typecheck": "tsc --noEmit",
    "build": "cre-compile ./main.ts ./dist/workflow.wasm",
    "test": "bun test ./workflow.test.ts",
    "worker:product": "node ./product-worker.mjs",
    "worker:http": "node ./worker-http.mjs",
    "test:hosting": "node --test ./worker-http.test.mjs ./cre-session.test.mjs"
  },
  "dependencies": {
    "@chainlink/cre-sdk": "1.23.0",
    "viem": "2.55.2",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/node": "24.0.0",
    "typescript": "5.9.3"
  }
}
