# Copy to .env.local after deploying the contracts to Monad mainnet (chain 143).
# `make deploy-mainnet` in contracts/ writes these two values automatically.
NEXT_PUBLIC_CORE_ADDRESS=0xyour_deployed_core_address
NEXT_PUBLIC_CIRCLE_FACTORY_ADDRESS=0xyour_deployed_factory_address
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key