# Copy to .env.local after deploying the contracts to Monad mainnet (chain 143).
# `make deploy-mainnet` in contracts/ writes these two values automatically.
NEXT_PUBLIC_CORE_ADDRESS=0xyour_deployed_core_address
NEXT_PUBLIC_CIRCLE_FACTORY_ADDRESS=0xyour_deployed_factory_address
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only. Never prefix these with NEXT_PUBLIC or expose them to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
BONDLINE_SESSION_SECRET=replace-with-at-least-32-random-characters
MONAD_RPC_URL=https://rpc.monad.xyz

# Protects the indexer endpoint. Generate a different random 32+ character value.
BONDLINE_INDEXER_SECRET=replace-with-another-32-random-characters
# Optional alternative used automatically by Vercel Cron.
CRON_SECRET=replace-with-a-third-32-random-characters
# Used only by the local backfill command; set this to the deployed app URL.
BONDLINE_APP_URL=https://your-bondline-deployment.example
# Optional indexer tuning. Defaults match the current Monad mainnet deployment.
BONDLINE_DEPLOYMENT_BLOCK=88718941
BONDLINE_INDEXER_FINALITY_BLOCKS=20
BONDLINE_INDEXER_BLOCK_RANGE=2000
BONDLINE_INDEXER_LOG_RANGE=100

# Strongly recommended for the initial historical backfill. Create a free
# server-side token at https://envio.dev/app/api-tokens.
HYPERSYNC_BEARER_TOKEN=your-envio-hypersync-token
BONDLINE_HYPERSYNC_URL=https://monad.hypersync.xyz
BONDLINE_INDEXER_HYPERSYNC_BLOCK_RANGE=2000000
